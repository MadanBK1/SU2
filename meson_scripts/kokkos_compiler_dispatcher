#!/usr/bin/env bash

# Preserve Kokkos' CMake compiler-launcher behavior after Meson imports the
# CMake targets. Meson invokes this program as the C++ compiler. Ordinary
# translation units go to the configured host compiler, while targets marked
# with KOKKOS_DEPENDENCE are redirected through Kokkos' nvcc_wrapper.

set -e

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
kokkos_dir="${script_dir}/../subprojects/Kokkos"
host_compiler="${SU2_KOKKOS_HOST_COMPILER:-nvc++}"

kokkos_dependence=0
has_kokkos_marker=0
has_extended_lambda=0
has_cuda_arch=0
has_cxx_standard=0
kokkos_args=()
for arg in "$@"; do
  if [[ "${arg}" == *KOKKOS_DEPENDENCE ]]; then
    kokkos_dependence=1
    has_kokkos_marker=1
  elif [[ "${arg}" == "-DHAVE_KOKKOS" ]]; then
    kokkos_dependence=1
  fi

  case "${arg}" in
    -extended-lambda|--extended-lambda|-expt-extended-lambda|--expt-extended-lambda)
      has_extended_lambda=1
      ;;
    -arch=*|--gpu-architecture=*)
      has_cuda_arch=1
      ;;
    -std=*|--std=*)
      has_cxx_standard=1
      ;;
  esac

  # GCC-like Meson compilers use -MQ for the depfile target. Kokkos 5.2's
  # nvcc_wrapper only recognizes -MT; an unrecognized -MQ is forwarded to
  # GCC without the matching dependency mode and cc1plus rejects it. Ninja
  # object paths do not require make-style quoting, so -MT is equivalent here.
  if [[ "${arg}" == "-MQ" ]]; then
    kokkos_args+=("-MT")
    continue
  fi

  # CMake adds NVHPC's -fast preset for Release builds. Kokkos-dependent
  # sources are compiled by nvcc_wrapper with a GNU host compiler, where that
  # option is invalid. The imported command already contains -O3.
  if [[ "${arg}" != "-fast" ]]; then
    kokkos_args+=("${arg}")
  fi
done

if [[ "${kokkos_dependence}" -eq 1 ]]; then
  # kokkos_launch_compiler uses this marker to authorize redirection. SU2
  # targets carry HAVE_KOKKOS instead, so add the launcher's marker as well.
  if [[ "${has_kokkos_marker}" -eq 0 ]]; then
    kokkos_args+=("-DKOKKOS_DEPENDENCE")
  fi
  # Kokkos' CUDA options are private to its imported library targets and are
  # not propagated to SU2 sources that instantiate KOKKOS_LAMBDA.
  if [[ "${has_extended_lambda}" -eq 0 ]]; then
    kokkos_args+=("-extended-lambda")
  fi
  if [[ "${has_cuda_arch}" -eq 0 ]]; then
    kokkos_args+=("-arch=${SU2_KOKKOS_CUDA_ARCH:-sm_90}")
  fi
  # Meson's CMake importer does not preserve CXX_STANDARD on the imported
  # Kokkos targets. Kokkos 5 requires C++20, so enforce it when no standard
  # was supplied by the parent target.
  if [[ "${has_cxx_standard}" -eq 0 ]]; then
    kokkos_args+=("-std=c++20")
  fi
  exec "${kokkos_dir}/bin/kokkos_launch_compiler" \
    "${kokkos_dir}/bin/nvcc_wrapper" "$0" "$0" "${kokkos_args[@]}"
fi

host_args=()
if [[ -n "${SU2_KOKKOS_GCC_TOOLCHAIN:-}" ]]; then
  host_args+=("--gcc-toolchain=${SU2_KOKKOS_GCC_TOOLCHAIN}")
fi

exec "${host_compiler}" "${host_args[@]}" "$@"
